// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
model Personalization {
  id              String   @id @default(cuid())
  shop            String
  draftOrderId    String
  lineItemId      String
  variantId       String?
  sourceQuantity  Int?
  isActive        Boolean  @default(true)
  productTitle    String
  type            String
  quantity        Int
  size            String?
  color           String?
  location        String?
  customText      String?
  logoUrl         String?
  logoMimeType    String?
  logoFileName    String?
  dimensions      String?
  createdAt       DateTime @default(now())
  proofs          Proof[]
}

// Statuts possibles pour le champ "status" (pas d'enum natif : SQLite ne le supporte pas) :
// "en_attente" | "approuve" | "modification_demandee"
model Proof {
  id                String    @id @default(cuid())
  personalizationId String
  personalization   Personalization @relation(fields: [personalizationId], references: [id])
  imageUrl          String
  mimeType          String?
  fileName          String?
  version           Int       @default(1)
  isCurrent         Boolean   @default(true)
  supersedesId      String?
  snapshot          Json?
  approvedVia       String?
  status            String    @default("en_attente")
  commentaireClient String?
  token             String    @unique @default(cuid())
  envoyeLe          DateTime?
  reponduLe         DateTime?
  createdAt         DateTime  @default(now())
}

// Une carte par personnalisation (pas par commande) : les différents
// produits d'une même commande peuvent partir chez des partenaires
// différents (ex: broderie chez l'un, impression chez l'autre) et doivent
// donc pouvoir avancer indépendamment. Créées automatiquement quand un
// devis brouillon personnalisé est complété en commande.
// Statuts possibles : "a_faire" | "en_cours" | "termine"
model KanbanCard {
  id                String    @id @default(cuid())
  shop              String
  draftOrderId      String
  orderId           String
  orderName         String
  personalizationId String    @unique
  status            String    @default("a_faire")
  archivedAt        DateTime?
  lastSentAt        DateTime?
  lastSentTo        String?
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Réglages généraux de l'app pour une boutique (un seul enregistrement par shop).
// Les champs *Subject/*Message sont optionnels : quand ils sont vides, les
// fonctions d'envoi (send-*-email.server.js) retombent sur un texte par
// défaut. Placeholders supportés : {{orderName}}, {{productTitle}}.
model ShopSettings {
  id                   String  @id @default(cuid())
  shop                 String  @unique
  artworkIndexedAt     DateTime?
  notificationEmail    String?
  clientEmailSubject   String?
  clientEmailMessage   String?
  partnerEmailSubject  String?
  partnerEmailMessage  String?
}

// Email du partenaire habituel pour un type de personnalisation donné
// (ex: Broderie -> email du brodeur). Mémorisé automatiquement à chaque
// envoi depuis le Kanban, ou modifiable depuis la page Réglages.
model PartnerEmail {
  id    String @id @default(cuid())
  shop  String
  type  String
  email String
  @@unique([shop, type])
}

model ArtworkCase {
  id              String @id @default(cuid())
  shop            String
  draftOrderId    String
  name            String
  email           String?
  customerName    String?
  yachtName       String?
  shopifyStatus   String @default("OPEN")
  orderId         String?
  orderName       String?
  shopifyCreatedAt DateTime?
  shopifyUpdatedAt DateTime?
  syncedAt        DateTime?
  archivedAt      DateTime?
  createdAt       DateTime @default(now())
  events          ArtworkEvent[]
  @@unique([shop, draftOrderId])
  @@index([shop, archivedAt, shopifyUpdatedAt])
}

model ArtworkItem {
  id           String @id @default(cuid())
  shop         String
  draftOrderId String
  lineItemId   String
  variantId    String?
  title        String
  variantTitle String?
  sku          String?
  quantity     Int
  requirement  String @default("pending")
  isActive     Boolean @default(true)
  @@unique([shop, draftOrderId, lineItemId])
  @@index([shop, draftOrderId, isActive])
}

model ArtworkEvent {
  id         String @id @default(cuid())
  caseId     String
  dossier    ArtworkCase @relation(fields: [caseId], references: [id])
  message    String
  actor      String @default("Équipe")
  createdAt  DateTime @default(now())
  @@index([caseId, createdAt])
}

// Delivery documents are independent of artwork cases and draft orders.
model DeliveryRepresentative {
  id             String   @id @default(cuid())
  shop           String
  name           String
  email          String?
  accessHash     String   @unique
  pinHash        String
  isActive       Boolean  @default(true)
  failedAttempts Int      @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime @default(now())
  notes          DeliveryNote[]
  sessions       DeliverySession[]
  @@index([shop, isActive])
}

model DeliverySession {
  id               String   @id @default(cuid())
  representativeId String
  representative   DeliveryRepresentative @relation(fields: [representativeId], references: [id], onDelete: Cascade)
  tokenHash        String   @unique
  csrf             String
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  @@index([representativeId, expiresAt])
}

model DeliveryNote {
  id                  String   @id @default(cuid())
  number              Int      @unique @default(autoincrement())
  shop                String
  orderId             String
  orderName           String
  representativeId    String
  representative      DeliveryRepresentative @relation(fields: [representativeId], references: [id])
  status              String   @default("READY")
  revision            Int      @default(1)
  sourceHash          String
  searchText          String   @default("")
  snapshot            Json
  createKey           String
  createHash          String
  signatureKey        String?
  receipt             Json?
  signedAt            DateTime?
  proofHash           String?
  emailTo             String?
  emailFrom           String?
  emailState          String   @default("NOT_REQUESTED")
  emailFirstAttemptAt DateTime?
  emailLockAt         DateTime?
  emailSentAt         DateTime?
  emailId             String?
  emailError          String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  document            DeliveryDocument?
  events              DeliveryEvent[]
  @@unique([shop, createKey])
  @@index([shop, orderId, status])
  @@index([representativeId, status, createdAt])
}

model DeliveryDocument {
  noteId    String   @id
  note      DeliveryNote @relation(fields: [noteId], references: [id])
  pdf       Bytes
  sha256    String
  createdAt DateTime @default(now())
}

model DeliveryEvent {
  id        String   @id @default(cuid())
  noteId    String
  note      DeliveryNote @relation(fields: [noteId], references: [id])
  actor     String
  kind      String
  details   Json?
  createdAt DateTime @default(now())
  @@index([noteId, createdAt])
}
