// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}
model Personalization {
  id              String   @id @default(cuid())
  shop            String
  draftOrderId    String
  lineItemId      String
  productTitle    String
  type            String
  quantity        Int
  size            String?
  color           String?
  location        String?
  customText      String?
  logoUrl         String?
  createdAt       DateTime @default(now())
  proofs          Proof[]
}

// Statuts possibles pour le champ "status" (pas d'enum natif : SQLite ne le supporte pas) :
// "en_attente" | "approuve" | "modification_demandee"
model Proof {
  id                String    @id @default(cuid())
  personalizationId String
  personalization   Personalization @relation(fields: [personalizationId], references: [id])
  imageUrl          String
  mimeType          String?
  status            String    @default("en_attente")
  commentaireClient String?
  token             String    @unique @default(cuid())
  envoyeLe          DateTime?
  reponduLe         DateTime?
  createdAt         DateTime  @default(now())
}

// Une carte par personnalisation (pas par commande) : les différents
// produits d'une même commande peuvent partir chez des partenaires
// différents (ex: broderie chez l'un, impression chez l'autre) et doivent
// donc pouvoir avancer indépendamment. Créées automatiquement quand un
// devis brouillon personnalisé est complété en commande.
// Statuts possibles : "a_faire" | "en_cours" | "termine"
model KanbanCard {
  id                String    @id @default(cuid())
  shop              String
  draftOrderId      String
  orderId           String
  orderName         String
  personalizationId String    @unique
  status            String    @default("a_faire")
  startDate         DateTime?
  endDate           DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

// Réglages généraux de l'app pour une boutique (un seul enregistrement par shop).
model ShopSettings {
  id                String @id @default(cuid())
  shop              String @unique
  notificationEmail String?
}

// Email du partenaire habituel pour un type de personnalisation donné
// (ex: Broderie -> email du brodeur). Mémorisé automatiquement à chaque
// envoi depuis le Kanban, ou modifiable depuis la page Réglages.
model PartnerEmail {
  id    String @id @default(cuid())
  shop  String
  type  String
  email String

  @@unique([shop, type])
}